# ============================================================
# DigiPlyra — environment variables
# Copy to .env.local and fill in your values
# ============================================================

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://zmdzkjrqocsjbiygglui.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# ^ Find both keys in Supabase Dashboard → Project Settings → API

# Public site URL (required for SSLCommerz callbacks)
# Local: http://localhost:3000 | Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- SSLCommerz (card / mobile-banking payments) ----
# Get Store ID + Password from https://www.sslcommerz.com
# Leave SSLCOMMERZ_ENABLED=false until you have live/sandbox credentials.
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Manual payments (bKash / Nagad / Rocket) are configured
# in the Admin Panel → Settings (no env needed).

# Owner admin access (no SQL needed): any account signing in with one of
# these emails is auto-promoted to admin on first /admin visit.
# Set the same value in Vercel → Settings → Environment Variables.
ADMIN_EMAILS=you@gmail.com
